[user]
	name = Siming Feng
	email = sfeng@roblox.com
[filter "lfs"]
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
[maintenance]
	repo = /Users/sfeng/git/roblox/deployment
[include]
	path = ~/.config/git/common.inc
# ── Credentials (keep last) ─────────────────────────────────────────────────
# Catch-all GCM; GitHub hosts use osxkeychain PATs (seeded by scripts/setup.sh)
# because gh's token 403s on git-write.
# ORDER: generic [credential] MUST precede the per-host blocks, else its empty
# reset wipes their helper. Verify:
#   printf 'protocol=https\nhost=github.rbx.com\n\n' | GIT_TRACE=1 git credential fill
[credential]
	helper = 
	helper = /usr/local/share/gcm-core/git-credential-manager
[credential "https://github.com"]
	helper =
	helper = osxkeychain
	username = simingf
[credential "https://github.rbx.com"]
	helper =
	helper = osxkeychain
	username = sfeng
[credential "https://dev.azure.com"]
	useHttpPath = true
# github.com/Roblox/* → sfeng-roblox account (not simingf). Must follow the
# credential blocks so its username wins.
[includeIf "hasconfig:remote.*.url:https://github.com/Roblox/**"]
	path = ~/.config/git/github-roblox.inc
