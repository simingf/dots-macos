# Term
term = xterm-ghostty

# Theme
theme = Rose Pine

# Iris-forward accents — shared #ceacf6 across tmux / nvim / lazygit
cursor-color = #ceacf6
cursor-text = #191724
selection-background = #ceacf6
selection-foreground = #191724

# Fonts
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Padding (matches kitty)
window-padding-x = 20
window-padding-y = 15

# macOS
macos-option-as-alt = left
macos-titlebar-style = hidden

# Mouse: shift-drag goes to tmux too (copies + clears on release); ⌘-click still opens URLs.
# copy-on-select covers raw ghostty windows with no tmux grabbing the mouse.
mouse-shift-capture = true
copy-on-select = clipboard

# Keybinds — clear defaults. ⌘ keys send \e[90NN~ for tmux-cmdkey.sh (see KEYBINDS.md)
keybind = clear
keybind = cmd+n=new_window
keybind = cmd+w=close_surface
keybind = cmd+v=paste_from_clipboard
keybind = cmd+a=text:\x1b[9001~
keybind = cmd+c=text:\x1b[9002~
keybind = cmd+x=text:\x1b[9003~
keybind = cmd+z=text:\x1b[9004~
keybind = cmd+shift+z=text:\x1b[9005~
keybind = cmd+left=text:\x1b[9006~
keybind = cmd+right=text:\x1b[9007~
keybind = cmd+s=text:\x1b[9008~
keybind = cmd+shift+backspace=text:\x1b[9009~
keybind = cmd+f=text:\x1b[9010~
keybind = cmd+p=text:\x1b[9011~
keybind = cmd+slash=text:\x1b[9012~
keybind = cmd+bracket_right=text:\x1b[9013~
keybind = cmd+bracket_left=text:\x1b[9014~
keybind = cmd+backspace=text:\x1b[9015~
# ⌥⌫ deletes a word with either Option key (macos-option-as-alt only covers the left one)
keybind = alt+backspace=text:\x1b\x7f
keybind = cmd+shift+left=text:\x1b[9016~
keybind = cmd+shift+right=text:\x1b[9017~
keybind = cmd+equal=increase_font_size:1
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size
keybind = cmd+q=quit
