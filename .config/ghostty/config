# Term
term = xterm-ghostty

# Theme
theme = Rose Pine

# Iris-forward accents — shared #ceacf6 across tmux / nvim / lazygit
cursor-color = #ceacf6
cursor-text = #191724
selection-background = #ceacf6
selection-foreground = #191724

# Fonts
font-family = JetBrainsMono Nerd Font Mono
font-size = 14

# Padding (your window_padding_width 15 20 15)
window-padding-x = 20
window-padding-y = 15

# macOS
macos-option-as-alt = left
macos-titlebar-style = hidden

# Mouse selection — always route drag-selection through tmux so the highlight
# clears and copies on release (tmux's copy-pipe-and-cancel). mouse-shift-capture
# = true stops Shift from bypassing tmux's mouse grab, so shift-drag no longer
# triggers ghostty's own selection (which stays highlighted and, by default, only
# writes the selection buffer — the "highlighted but not copied" case). URLs still
# open with ⌘-click on macOS (a separate modifier, unaffected by this).
# copy-on-select is the fallback for surfaces where tmux isn't grabbing the mouse
# (a raw ghostty window): those selections at least reach the real clipboard.
mouse-shift-capture = true
copy-on-select = clipboard

# Keybinds — clear all defaults, keep only these
keybind = clear
keybind = cmd+n=new_window
keybind = cmd+w=close_surface
keybind = cmd+v=paste_from_clipboard
keybind = cmd+backspace=text:\x15
keybind = cmd+a=text:\x1b[9001~
keybind = cmd+c=text:\x1b[9002~
keybind = cmd+x=text:\x1b[9003~
keybind = cmd+z=text:\x1b[9004~
keybind = cmd+shift+z=text:\x1b[9005~
keybind = cmd+left=text:\x1b[9006~
keybind = cmd+right=text:\x1b[9007~
keybind = cmd+equal=increase_font_size:1
keybind = cmd+plus=increase_font_size:1
keybind = cmd+minus=decrease_font_size:1
keybind = cmd+zero=reset_font_size
keybind = cmd+q=quit
