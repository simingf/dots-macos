{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#e0def4",
    "margin": 2
  },
  "block_quote": {
    "color": "#908caa",
    "italic": true,
    "indent": 1,
    "indent_token": "│ "
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#ceacf6",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#191724",
    "background_color": "#ceacf6",
    "bold": true
  },
  "h2": {
    "prefix": "## ",
    "color": "#ceacf6",
    "bold": true
  },
  "h3": {
    "prefix": "### ",
    "color": "#9ccfd8",
    "bold": true
  },
  "h4": {
    "prefix": "#### ",
    "color": "#ebbcba",
    "bold": true
  },
  "h5": {
    "prefix": "##### ",
    "color": "#f6c177"
  },
  "h6": {
    "prefix": "###### ",
    "color": "#31748f"
  },
  "text": {},
  "strikethrough": {
    "color": "#6e6a86",
    "crossed_out": true
  },
  "emph": {
    "color": "#ebbcba",
    "italic": true
  },
  "strong": {
    "color": "#f6c177",
    "bold": true
  },
  "hr": {
    "color": "#6e6a86",
    "format": "\n─────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#9ccfd8",
    "underline": true
  },
  "link_text": {
    "color": "#ceacf6",
    "bold": true
  },
  "image": {
    "color": "#ebbcba",
    "underline": true
  },
  "image_text": {
    "color": "#908caa",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#eb6f92",
    "background_color": "#26233a"
  },
  "code_block": {
    "color": "#908caa",
    "margin": 2,
    "chroma": {
      "text": { "color": "#e0def4" },
      "error": { "color": "#e0def4", "background_color": "#eb6f92" },
      "comment": { "color": "#6e6a86", "italic": true },
      "comment_preproc": { "color": "#f6c177" },
      "keyword": { "color": "#31748f" },
      "keyword_reserved": { "color": "#ceacf6" },
      "keyword_namespace": { "color": "#eb6f92" },
      "keyword_type": { "color": "#9ccfd8" },
      "operator": { "color": "#31748f" },
      "punctuation": { "color": "#908caa" },
      "name": { "color": "#e0def4" },
      "name_builtin": { "color": "#ebbcba" },
      "name_tag": { "color": "#9ccfd8" },
      "name_attribute": { "color": "#f6c177" },
      "name_class": { "color": "#f6c177", "bold": true },
      "name_constant": { "color": "#ceacf6" },
      "name_decorator": { "color": "#ebbcba" },
      "name_exception": { "color": "#eb6f92" },
      "name_function": { "color": "#ebbcba" },
      "name_other": { "color": "#e0def4" },
      "literal": { "color": "#f6c177" },
      "literal_number": { "color": "#f6c177" },
      "literal_string": { "color": "#f6c177" },
      "literal_string_escape": { "color": "#ceacf6" },
      "generic_deleted": { "color": "#eb6f92" },
      "generic_emph": { "italic": true },
      "generic_inserted": { "color": "#9ccfd8" },
      "generic_strong": { "bold": true },
      "generic_subheading": { "color": "#ceacf6" },
      "background": { "background_color": "#191724" }
    }
  },
  "table": {
    "center_separator": "┼",
    "column_separator": "│",
    "row_separator": "─"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n🠶 "
  },
  "html_block": {},
  "html_span": {}
}
