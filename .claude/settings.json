{
  "cleanupPeriodDays": 7,
  "env": {},
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "mcp__mcp-gateway-glean",
      "mcp__mcp-gateway-sourcegraph",
      "mcp__trino__execute_sql",
      "mcp__mcp-gateway-slack",
      "mcp__mcp-gateway-gmail",
      "mcp__mcp-gateway-gcalendar",
      "mcp__mcp-gateway-gdrive",
      "mcp__mcp-gateway-ros",
      "mcp__mcp-gateway-mosaic_mds",
      "mcp__mcp-gateway-teamcity",
      "mcp__mcp-gateway-sentry_onprem",
      "mcp__mcp-gateway-atlassian"
    ],
    "deny": []
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh AskUserQuestion",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-notify.sh Stop",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-notify.sh Notification",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh Notification",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh PreCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh PostCompact",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh SessionEnd",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/hooks/agent-status.sh StopFailure",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark-ansi",
  "verbose": true,
  "tui": "fullscreen"
}